<Project Sdk="Microsoft.NET.Sdk">
  <!-- RimWorld 1.7 runs on .NET 10: the same Source, built against that game's own assemblies
       and Harmony's 1.7 build. build.ps1 passes Game17 and Harmony17. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RimTalkStagecraft</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <OutputPath>$(MSBuildThisFileDirectory)..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Game17>E:\RimWorld-1.7-test</Game17>
    <Harmony17>E:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</Harmony17>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Source\*.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(Game17)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(Game17)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(Game17)\Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Harmony17)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
